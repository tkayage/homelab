# .github/workflows/deploy.yml — generated by the homelab scaffolder.
# Do not edit by hand; re-run `scaffold` to regenerate.
#
# On push to main this builds a private GHCR image tagged sha-<short> (+ latest)
# and then bumps the gitops-homelab image ref so Argo CD deploys the new SHA.
# Every third-party action is pinned to a full commit SHA (supply-chain, T-06-03);
# permissions are minimized to contents:read + packages:write (T-06-02).
name: deploy
on:
  push:
    branches: [main]
concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: false
permissions:
  contents: read
  packages: write
jobs:
  build:
    runs-on: ubuntu-latest
    outputs:
      short_sha: ${{ steps.vars.outputs.short_sha }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - id: vars
        # Derive the short SHA ONCE; both the image tag and the gitops bump
        # reuse this exact string so Argo never pulls a tag before it is pushed
        # (RESEARCH Pitfall 5).
        run: echo "short_sha=${GITHUB_SHA::7}" >> "$GITHUB_OUTPUT"
      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1
      - uses: docker/login-action@5e57cd118135c172c3672efd75eb46360885c0ef # v3.6.0
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - id: meta
        uses: docker/metadata-action@318604b99e75e41977312d83839a89be02ca4893 # v5.9.0
        with:
          images: ghcr.io/tkayage/myapp
          # value=sha-<short_sha> (not type=sha,format=short) so the pushed tag
          # is byte-identical to the string the bump job pins (Pitfall 5).
          tags: |
            type=raw,value=sha-${{ steps.vars.outputs.short_sha }}
            type=raw,value=latest,enable={{is_default_branch}}
      - uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0
        with:
          context: .
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  bump:
    # needs: build so the gitops ref only advances after the image is pushed —
    # otherwise Argo could try to pull sha-<short> before it exists (Pitfall 4).
    needs: build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          # Cross-repo push uses a fine-grained PAT scoped to gitops-homelab
          # Contents:write ONLY (least privilege, T-06-01) — never the GHCR token.
          repository: tkayage/gitops-homelab
          token: ${{ secrets.GITOPS_PUSH_TOKEN }}
          ref: main
      - name: install kustomize
        run: |
          curl -sfL https://raw.githubusercontent.com/kubernetes-sigs/kustomize/master/hack/install_kustomize.sh | bash -s 5.4.3 /usr/local/bin
      - name: pin image
        working-directory: apps/myapp
        # Reuse the EXACT short SHA from the build job's output (Pitfall 5); the
        # image key is byte-identical to the Deployment image string (Pitfall 2).
        run: |
          kustomize edit set image ghcr.io/tkayage/myapp=ghcr.io/tkayage/myapp:sha-${{ needs.build.outputs.short_sha }}
      - name: commit + push
        run: |
          git config user.name  "homelab-ci"
          git config user.email "ci@homelab.invalid"
          git add apps/myapp/kustomization.yaml
          git commit -m "deploy(myapp): sha-${{ needs.build.outputs.short_sha }}" || exit 0
          # Two-writer contention: each app edits only its own apps/<slug>/, but
          # concurrent bumps still race the push — rebase-retry a few times (Pitfall 6).
          pushed=0
          for i in 1 2 3; do
            if git pull --rebase origin main && git push origin main; then
              pushed=1
              break
            fi
            sleep $((RANDOM % 5 + 2))
          done
          if [ "$pushed" -ne 1 ]; then
            echo "::error::gitops push failed after 3 retries" >&2
            exit 1
          fi
